# Copie para .env.local (local) ou cadastre na Vercel (Settings → Environment Variables)

# MongoDB Atlas (plano M0 gratuito) — string de conexão do cluster
MONGODB_URI=mongodb+srv://usuario:senha@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Opcional: nome do banco (padrão: grafite-notas)
MONGODB_DB=grafite-notas

# Senha única para entrar no app em cada aparelho
APP_PASSWORD=

# Chave grátis do Gemini, sem cartão: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcional: modelo (padrão: gemini-flash-latest)
GEMINI_MODEL=
